{
  "name": "keepkey-vault-sdk",
  "version": "3.0.1",
  "description": "Typed TypeScript SDK for the KeepKey REST API — zero dependencies, native fetch, works in browser, Node, Bun, and edge runtimes.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./openapi/swagger.json": "./openapi/swagger.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "openapi",
    "README.md"
  ],
  "scripts": {
    "bundle:openapi": "node scripts/bundle-openapi.mjs",
    "build": "npm run bundle:openapi && tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node __tests__/test.js",
    "test:chain": "npm run build && node tests/run-all.js chain",
    "test:sweep": "npm run build && node tests/run-all.js sweep",
    "test:all": "npm run build && node tests/run-all.js",
    "test:device": "npm run build && node tests/run-all.js"
  },
  "keywords": [
    "keepkey",
    "hardware-wallet",
    "hardware",
    "wallet",
    "bitcoin",
    "ethereum",
    "cosmos",
    "sdk",
    "rest",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keepkey/keepkey-vault.git",
    "directory": "projects/keepkey-sdk"
  },
  "bugs": {
    "url": "https://github.com/keepkey/keepkey-vault/issues"
  },
  "homepage": "https://docs.keepkey.com",
  "author": "KeepKey",
  "license": "MIT",
  "devDependencies": {
    "ethers": "^6.16.0",
    "typescript": "^5.5.0"
  }
}
